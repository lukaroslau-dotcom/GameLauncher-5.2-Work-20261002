<UserControl x:Class="GameLauncher.Views.BackupsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer><StackPanel>
  <TextBlock Text="Backups" Style="{DynamicResource PageTitle}"/>
  <TextBlock Text="Verifizierte Spielstände. Zwei aktive Versionen; ältere Sicherungen bleiben im Archiv erhalten." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,22"/>
  <Border Style="{DynamicResource GlassPanel}" Margin="0,0,0,20"><StackPanel>
   <TextBlock Text="Automatische Sicherung" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14"/>
   <WrapPanel><CheckBox x:Name="Before" Content="Vor Spielstart" Click="OptionsChanged" Margin="0,0,24,12"/><CheckBox x:Name="After" Content="Nach Spielende" Click="OptionsChanged" Margin="0,0,24,12"/>
    <CheckBox x:Name="Scheduled" Content="Alle 60 Minuten, solange der Launcher aktiv ist" Click="OptionsChanged" Margin="0,0,0,12"/></WrapPanel>
   <TextBlock Text="Während ein Spiel läuft, werden zeitgesteuerte Sicherungen pausiert. Fehlende Save-Pfade werden angezeigt." Style="{DynamicResource BodyText}" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <DockPanel Margin="0,0,0,16"><Button Content="Aktualisieren" Click="Refresh_Click" DockPanel.Dock="Right"/><TextBlock Text="Deine Spielstände" Style="{DynamicResource SectionTitle}"/></DockPanel>
  <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource AccentColor}"/>
  <ItemsControl x:Name="Rows"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{DynamicResource GlassPanel}" Margin="0,0,0,12"><StackPanel>
    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Description}" Style="{DynamicResource BodyText}" Margin="0,8,0,14" TextWrapping="Wrap"/>
    <WrapPanel><Button Content="Jetzt sichern" Click="Backup_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Integrität prüfen" Click="Verify_Click" Margin="0,0,10,8"/><Button Content="In neuen Ordner wiederherstellen …" Click="Restore_Click" Margin="0,0,10,8"/><Button Content="Alle Versionen öffnen" Click="History_Click" Margin="0,0,10,8"/></WrapPanel>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="Entfernte Installationen" Style="{DynamicResource SectionTitle}" Margin="0,24,0,14"/>
  <TextBlock Text="Zur Sicherheit behaltene Ordner. Wiederherstellen überschreibt keine vorhandene Installation." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <ItemsControl x:Name="RecoveryRows"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource GlassPanel}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Stored}" TextWrapping="Wrap" Style="{DynamicResource BodyText}" Margin="0,8,0,12"/><Button Content="Installation wiederherstellen …" Click="RestoreInstallation_Click" HorizontalAlignment="Left"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
