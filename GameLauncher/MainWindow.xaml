                                                    <Button Content="Als Standard" Click="VersionSetDefault_Click" Style="{DynamicResource SecondaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding GameVersion}"/>
                                                        <TextBlock Style="{DynamicResource BodyText}" Foreground="{DynamicResource TextSecondary}" Text="{Binding GamePath}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
