                </StackPanel></ScrollViewer>
            </Grid>

            <Grid x:Name="WaitingForUpdatesView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Warten auf Updates" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Für später aufgehoben" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ListBox x:Name="GameItemsControlWaiting" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                    <StackPanel x:Name="WaitingEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Hier wartet noch kein Spiel." Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="FinishedView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Abgeschlossen" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Ein Teil deiner Spielgeschichte" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ListBox x:Name="GameItemsControlFinished" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                    <StackPanel x:Name="FinishedEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Noch keine abgeschlossenen Spiele." Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="DeletedView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Gelöscht" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Entfernte Spiele bleiben hier als Eintrag erhalten und können erneut eingebunden werden." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <ListBox x:Name="GameItemsControlDeleted" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                    <StackPanel x:Name="DeletedEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Keine gelöschten Spiele." Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="InstallGameView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Erneut installieren" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Bekanntes Spiel, gleiche Historie" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Content="Zurück" Click="BackFromInstallButton_Click" Style="{StaticResource SecondaryButton}" Width="105" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="80" Height="80" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SurfaceSecondary}">
                                    <controls:CroppedImage x:Name="InstallCoverImage"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock x:Name="InstallKnownNameTextBlock" Text="Game" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="InstallGameIdTextBlock" Text="ID" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="InstallVersionTextBlock" Text="Version" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="InstallSourceTextBlock" Text="Quelle" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Neue Version" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="InstallVersionTextBox" Margin="0,0,0,15"/>
                        <TextBlock Text="Spielordner" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallGamePathTextBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Wählen" Click="SelectInstallGameFolder_Click" Style="{StaticResource SecondaryButton}" Width="95" Margin="10,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Startdatei" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallExecutableTextBox" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Wählen" Click="SelectInstallExecutable_Click" Style="{StaticResource SecondaryButton}" Width="95" Margin="10,0,0,0"/>
                        </Grid>
                        <Button Content="Komprimierte Spieldatei entpacken …" Click="ExtractArchiveForReinstall_Click" HorizontalAlignment="Left" Margin="0,0,0,15"/>
                        <TextBlock Text="Spielstandordner (optional)" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallSavePathTextBox"/>
                            <Button Grid.Column="1" Content="Wählen" Click="SelectInstallSaveFolder_Click" Style="{StaticResource SecondaryButton}" Width="95" Margin="10,0,0,0"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12"><Button Content="Saves finden" Click="FindSaves_Click" Margin="0,0,8,8"/><Button x:Name="InstallProbeSaveButton" Content="Spiel starten und Save-Ordner suchen" Click="LaunchToCreateSave_Click" Margin="0,0,8,8"/><Button Content="Später festlegen" Click="UnknownSave_Click" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="InstallArchiveStatusTextBlock" Text="Kein archivierter Spielstand" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="RestoreSaveCheckBox" Content="Archivierten Spielstand wiederherstellen" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0" IsEnabled="False"/>
                                <CheckBox x:Name="TransferCurrentSaveCheckBox" Content="Aktuellen Spielstand in die neue Version übertragen (mit Sicherheitskopie)" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0"/>
                                <CheckBox x:Name="KeepOldInstallationCheckBox" Content="Alte Spielversion zur Kontrolle behalten" Foreground="{DynamicResource TextPrimary}" Margin="0,12,0,0" IsChecked="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Button Content="Installieren" Click="ConfirmInstallButton_Click" Style="{StaticResource PrimaryButton}" Width="170" HorizontalAlignment="Right" Margin="0,20,0,0" Grid.Row="2"/>
            </Grid>

            <Grid x:Name="SettingsView" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,18"><TextBlock Text="Einstellungen" Style="{DynamicResource PageTitle}"/><TextBlock Text="Dein Launcher. So, wie du ihn magst." Style="{DynamicResource BodyText}" Margin="0,6,0,0"/><WrapPanel Margin="0,14,0,0"><Button Content="Einstellungen exportieren" Click="ExportSettings_Click" Margin="0,0,10,8"/><Button Content="Einstellungen importieren …" Click="ImportSettings_Click" Margin="0,0,10,8"/><Button Content="Bibliothek &amp; Backups exportieren" Click="ExportLibraryPackage_Click" Margin="0,0,10,8"/><Button Content="Diagnoseprotokolle" Click="OpenDiagnostics_Click" Margin="0,0,10,8"/></WrapPanel></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,96">
<controls:AdaptiveColumns Breakpoint="900"><Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Allgemein" Style="{DynamicResource SectionTitle}" Margin="0,0,0,20"/><CheckBox x:Name="SettingsAutostartCheckBox" Content="Mit Windows starten" Margin="0,0,0,12"/><CheckBox x:Name="SettingsTrayCheckBox" Content="Beim Schließen in den Infobereich minimieren" Margin="0,0,0,12"/><CheckBox x:Name="SettingsEnergyCheckBox" Content="Ruhemodus während des Spielens" Margin="0,0,0,12"/><CheckBox x:Name="SettingsRestoreCheckBox" Content="Launcher nach Spielende wieder anzeigen" Margin="0,0,0,12"/></StackPanel></Border>
<Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Darstellung" Style="{DynamicResource SectionTitle}" Margin="0,0,0,20"/><TextBlock Text="Dunkel · große Cover · violette Akzente" Style="{DynamicResource BodyText}" Margin="0,0,0,16"/><DockPanel><TextBlock Text="UI-Skalierung"/><TextBlock Text="{Binding Value, ElementName=SettingsScaleSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="SettingsScaleSlider" Minimum="0.8" Maximum="2" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,14,0,18" ToolTip="Größe von Schrift und Bedienelementen"/><CheckBox x:Name="SettingsTransparencyCheckBox" Content="Transparenz reduzieren" Margin="0,0,0,12"/><CheckBox x:Name="SettingsMotionCheckBox" Content="Bewegung reduzieren" Margin="0,0,0,12"/><TextBlock Text="Hintergrundbild" Style="{DynamicResource BodyText}" Margin="0,8,0,6"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsBackgroundTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="…" Click="SelectBackground_Click" ToolTip="Hintergrundbild wählen" Margin="8,0,0,0"/></Grid><controls:CroppedImage x:Name="BackgroundPreview" ImagePath="{Binding Text, ElementName=SettingsBackgroundTextBox}" CanDrag="True" DecodeWidth="1000" Height="130" Margin="0,0,0,8" ToolTip="Hintergrund-Ausschnitt mit der Maus verschieben"/><TextBlock Text="Bild ziehen, um den Ausschnitt zu verschieben." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="Standardhintergrund" Click="ResetBackground_Click" HorizontalAlignment="Left"/></StackPanel></Border></controls:AdaptiveColumns>
<controls:AdaptiveColumns Breakpoint="900" Margin="0,20,0,0"><Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Tastatur und Maus" Style="{DynamicResource SectionTitle}" Margin="0,0,0,20"/><CheckBox x:Name="SettingsLaunchShortcutCheckBox" Content="Launcher auch im geschlossenen Zustand starten" Margin="0,0,0,12"/><DockPanel Margin="0,0,0,10"><TextBlock Text="Strg + Alt +" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="SettingsLaunchKeyTextBox" Text="G" MaxLength="1" Width="60" HorizontalAlignment="Left" ToolTip="Buchstabe oder Ziffer für den Launcher-Start"/></DockPanel><TextBlock Text="Windows-Startkombination · Standard: Strg + Alt + G" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/><CheckBox x:Name="SettingsKeyboardCheckBox" Content="Globale Tastenkombination aktivieren" Margin="0,0,0,12"/><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsHotkeyTextBox" IsReadOnly="True" PreviewKeyDown="CaptureHotkey_KeyDown"/><Button x:Name="CaptureHotkeyButton" Grid.Column="1" Content="Aufnehmen" Click="CaptureHotkey_Click" Margin="8,0,0,0"/></Grid><CheckBox x:Name="SettingsShortcutCheckBox" Content="Zusätzlich linke + rechte Maustaste" Margin="0,0,0,12"/><CheckBox x:Name="SettingsMinimizeGameCheckBox" Content="Auch das laufende Spiel minimieren" Margin="0,0,0,12"/></StackPanel></Border>
<Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Spielerkennung" Style="{DynamicResource SectionTitle}" Margin="0,0,0,20"/><CheckBox x:Name="SettingsDiscoveryCheckBox" Content="Neue Spiele automatisch erkennen" Margin="0,0,0,12"/><CheckBox x:Name="SettingsAutoAddCheckBox" Content="Eindeutige Funde automatisch hinzufügen" Margin="0,0,0,12"/><TextBlock Text="Spielordner / überwachter Ordner" Style="{DynamicResource BodyText}" Margin="0,8,0,6"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsDefaultGameFolderTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="…" Click="SelectDefaultGameFolder_Click" ToolTip="Spielordner / überwachter Ordner wählen" Margin="8,0,0,0"/></Grid></StackPanel></Border></controls:AdaptiveColumns>
<Border Style="{DynamicResource GlassPanel}" Margin="0,20,0,0">
    <StackPanel>
        <DockPanel Margin="0,0,0,12"><TextBlock Text="Handy- &amp; iPad-Host" Style="{DynamicResource SectionTitle}"/><TextBlock x:Name="RemoteHostStateText" Text="Aus" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></DockPanel>
        <TextBlock Text="DXGI-Vollbildaufnahme mit sichtbarer Maus und einem Latenzpuffer, der alte Bilder automatisch verwirft." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock x:Name="RemoteHostPerformanceText" Text="DXGI-Vollbildaufnahme bereit" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <WrapPanel Margin="0,0,0,12"><Button x:Name="RemoteHostToggleButton" Content="Host-Modus starten" Click="RemoteHostToggle_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Adresse kopieren" Click="CopyRemoteAddress_Click" Margin="0,0,8,8"/><Button Content="PIN kopieren" Click="CopyRemotePin_Click" Margin="0,0,8,8"/><Button Content="60 FPS · HD" Click="RemotePerformancePreset_Click" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock Text="Adresse auf iPhone/iPad" Style="{DynamicResource BodyText}"/><TextBox x:Name="RemoteHostAddressTextBox" IsReadOnly="True" Text="Host-Modus ist aus" Margin="0,6,0,10"/>
        <DockPanel Margin="0,0,0,14"><TextBlock Text="Sitzungs-PIN" Style="{DynamicResource BodyText}"/><TextBlock x:Name="RemoteHostPinText" Text="------" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentColor}"/></DockPanel>
        <CheckBox x:Name="SettingsRemoteAutoStartCheckBox" Content="Host-Modus beim Start des Launchers automatisch einschalten" Margin="0,0,0,12"/>
        <CheckBox x:Name="SettingsRemotePrivacyCheckBox" Content="PC-Bildschirm abdunkeln (bei DXGI deaktiviert, damit das Handybild sichtbar bleibt)" Margin="0,0,0,12" IsEnabled="False" ToolTip="Ein schwarzes Fenster wird von der Vollbildaufnahme mitgesendet. Deshalb bleibt diese Option aus, solange DXGI für Vollbildspiele verwendet wird."/>
        <CheckBox x:Name="SettingsRemotePerformanceCheckBox" Content="Streaming-Fokusmodus (Launcher-Scans pausieren und Spiel/Stream bevorzugen)" Margin="0,0,0,14"/>
        <DockPanel><TextBlock Text="Port" VerticalAlignment="Center"/><TextBox x:Name="SettingsRemotePortTextBox" Text="17840" Width="100" HorizontalAlignment="Right"/></DockPanel>
        <DockPanel Margin="0,14,0,0"><TextBlock Text="Bilder pro Sekunde"/><TextBlock Text="{Binding Value, ElementName=SettingsRemoteFpsSlider, StringFormat={}{0:0} FPS}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="SettingsRemoteFpsSlider" Minimum="15" Maximum="60" Value="60" TickFrequency="15" IsSnapToTickEnabled="True" Margin="0,8,0,8"/>
        <DockPanel><TextBlock Text="Bildqualität"/><TextBlock Text="{Binding Value, ElementName=SettingsRemoteQualitySlider, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="SettingsRemoteQualitySlider" Minimum="35" Maximum="92" Value="75" TickFrequency="5" Margin="0,8,0,8"/>
        <DockPanel><TextBlock Text="Streaming-Auflösung"/><TextBlock Text="{Binding Value, ElementName=SettingsRemoteWidthSlider, StringFormat={}{0:0}px breit}" HorizontalAlignment="Right"/></DockPanel>
        <Slider x:Name="SettingsRemoteWidthSlider" Minimum="1280" Maximum="1920" Value="1280" TickFrequency="640" IsSnapToTickEnabled="True" Margin="0,8,0,12"/>
        <TextBlock Text="HD/60 FPS ist das Zielprofil; die echte Rate wird live angezeigt und hängt von PC, Spiel und WLAN ab. Für Administrator-Spiele muss auch der GameLauncher als Administrator laufen." Style="{DynamicResource BodyText}" TextWrapping="Wrap"/>
    </StackPanel>
</Border>
<Border Style="{DynamicResource GlassPanel}" Margin="0,20,0,0"><StackPanel><TextBlock Text="F95-Updates &amp; Medien" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/><CheckBox x:Name="SettingsF95UpdatesCheckBox" Content="Automatisch nach neuen F95-Versionen suchen" Margin="0,0,0,12"/><CheckBox x:Name="SettingsF95NotificationsCheckBox" Content="Bei neuen Versionen benachrichtigen" Margin="0,0,0,12"/><CheckBox x:Name="SettingsF95GalleryCheckBox" Content="Fehlende F95-Galeriebilder automatisch herunterladen" Margin="0,0,0,16"/><DockPanel><TextBlock Text="Hover-Bildshow startet nach"/><TextBlock Text="{Binding Value, ElementName=SettingsHoverDelaySlider, StringFormat={}{0:0} Sekunden}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="SettingsHoverDelaySlider" Minimum="1" Maximum="15" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,16"/><DockPanel><TextBlock Text="Update-Prüfabstand"/><TextBlock Text="{Binding Value, ElementName=SettingsF95IntervalSlider, StringFormat={}{0:0} Stunden}" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="SettingsF95IntervalSlider" Minimum="6" Maximum="24" Value="12" TickFrequency="6" IsSnapToTickEnabled="True" Margin="0,14,0,10"/><Button Content="Metadaten für alle Spiele aktualisieren" Click="RefreshAllMetadata_Click" HorizontalAlignment="Left" Margin="0,8,0,12"/><TextBlock Text="Die Prüfung nutzt den unabhängigen F95Checker-Cache. Dein F95-Konto und Passwort werden nicht benötigt." Style="{DynamicResource BodyText}" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{DynamicResource GlassPanel}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Speicherorte" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/><TextBlock Text="Archiv und Bibliothek" Style="{DynamicResource BodyText}" Margin="0,8,0,6"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsArchivePathTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="…" Click="SelectArchivePath_Click" ToolTip="Archiv und Bibliothek wählen" Margin="8,0,0,0"/></Grid><TextBlock Text="GameLibrary für verwaltete Spiele" Style="{DynamicResource BodyText}" Margin="0,8,0,6"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsManagedGameFolderTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="…" Click="SelectManagedGameFolder_Click" ToolTip="GameLibrary-Ordner wählen" Margin="8,0,0,0"/></Grid><CheckBox x:Name="SettingsManageGamesCheckBox" Content="Neue lokale Spiele automatisch in die GameLibrary verschieben" Margin="0,0,0,12"/><Button Content="Vorhandene lokale Spiele jetzt übernehmen …" Click="MoveExistingGames_Click" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="Steam-, Epic-, Xbox- und Microsoft-Store-Spiele bleiben an ihrem vom Anbieter verwalteten Ort." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Standardordner für Spielstände" Style="{DynamicResource BodyText}" Margin="0,8,0,6"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SettingsDefaultSaveFolderTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="…" Click="SelectDefaultSaveFolder_Click" ToolTip="Standardordner für Spielstände wählen" Margin="8,0,0,0"/></Grid></StackPanel></Border>
</StackPanel></ScrollViewer><Button Grid.Row="2" Content="Einstellungen speichern" Click="SaveSettingsButton_Click" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0"/></Grid>
<Grid x:Name="SetupWizardHost" Visibility="Collapsed">
    <views:SetupWizardView x:Name="SetupWizard"/>
</Grid>

<Grid x:Name="ImportsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Entdecken" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>
    <WrapPanel Grid.Row="1" Margin="0,0,0,18">
        <Button x:Name="DiscoverNowButton" Content="Jetzt suchen" Click="DiscoverNow_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
        <Button x:Name="CancelScanButton" Content="Abbrechen" Click="CancelScan_Click" IsEnabled="False" Margin="0,0,10,8"/><Button Content="Ordner scannen" Click="ScanFolderButton_Click" Margin="0,0,10,8"/>
        <Button Content="JSON importieren" Click="ImportJsonButton_Click" Margin="0,0,10,8"/>
        <Button Content="Bibliothek exportieren" Click="ExportJson_Click" Margin="0,0,0,8"/>
    </WrapPanel>
    <TextBlock x:Name="DiscoveryStatusText" Grid.Row="2" Text="Noch kein Scan ausgeführt." Style="{StaticResource BodyText}" Margin="0,0,0,16" TextWrapping="Wrap"/>
    <ScrollViewer Grid.Row="3">
        <ItemsControl x:Name="ImportScanItemsControl">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,15">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DetectionLabel}" Foreground="{StaticResource SuccessColor}" FontSize="11" Margin="0,5,0,5"/>
                            <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource BodyText}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Click="ImportScannedGame_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Grid>
    </Grid>
    <Border x:Name="FloatingBottomNav" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="#181B20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            CornerRadius="26" Padding="6" Margin="0,0,0,-62" Panel.ZIndex="50">
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="NavHomeButton" Tag="Start" Click="NavHome_Click"
                         Style="{StaticResource BottomNavigationButton}">
                <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"/>
            </RadioButton>
            <RadioButton x:Name="NavLibraryButton" Tag="Bibliothek" Click="NavLibrary_Click"
                         Style="{StaticResource BottomNavigationButton}">
                <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"/>
            </RadioButton>
            <RadioButton x:Name="NavAddGameButton" Tag="Hinzufügen" Click="NavAddGame_Click"
                         Style="{StaticResource BottomNavigationButton}">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentColor}"/>
            </RadioButton>
            <RadioButton x:Name="NavUpdatesButton" Tag="Updates" Click="NavUpdates_Click"
                         Style="{StaticResource BottomNavigationButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"/>
                    <Border x:Name="NavUpdatesBadge" Background="{DynamicResource AccentColor}" CornerRadius="9"
                            Margin="6,0,0,0" Padding="5,1" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock x:Name="NavUpdatesBadgeText" Text="0" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavSettingsButton" Tag="Einstellungen" Click="NavSettings_Click"
                         Style="{StaticResource BottomNavigationButton}">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"/>
            </RadioButton>
        </StackPanel>
    </Border>
    <Border x:Name="ToastHost" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="11" Padding="16,12" Panel.ZIndex="200" MaxWidth="430">
                <TextBlock x:Name="ToastText" Text="" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
            </Border>

    </Grid>
    <Grid x:Name="DeleteGameDialog" Visibility="Collapsed" Panel.ZIndex="100" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#C80A0B0D"/>
                <Border MaxWidth="620" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                        Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="24">
                    <ScrollViewer><StackPanel>
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Installation entfernen" Style="{StaticResource PageTitle}"/><TextBlock x:Name="DeleteTargetText" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,8,35,0"/><CheckBox x:Name="NoSaveConfirmCheckBox" Content="Es gibt keinen Spielstand zu sichern." Visibility="Collapsed" Margin="0,14,0,0"/>
                                <TextBlock Text="Spielzeit und Historie bleiben erhalten." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Content="×" Click="CloseDeleteDialogButton_Click" Width="36" Height="36" HorizontalAlignment="Right" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" FontSize="20"/>
                        </Grid>
                        <Button Height="Auto" MinHeight="80" Click="WaitingForUpdatesButton_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <Border Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="AUF UPDATES WARTEN" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Nur den Status ändern. Installation und Spielstände bleiben erhalten." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Height="Auto" MinHeight="80" Click="FinishedGameButton_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <Border Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="ABSCHLIESSEN" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Als abgeschlossen markieren. Installation und Spielstände bleiben erhalten." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Height="Auto" MinHeight="80" Click="AbsoluteDeleteOption_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                            <Border Background="#2A1518" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="IN GELÖSCHT VERSCHIEBEN" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}"/>
                                    <TextBlock Text="Installation wiederherstellbar entfernen und Save-Archiv löschen; Quelle, Cover und Spielzeit als Eintrag behalten." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Content="Abbrechen" Click="CloseDeleteDialogButton_Click" Style="{StaticResource SecondaryButton}" Width="100" HorizontalAlignment="Right" Margin="0,20,0,0"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="DuplicateGameDialog" Visibility="Collapsed" Panel.ZIndex="90" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#C80A0B0D"/>
                <Border MaxWidth="560" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                        Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="24">
                    <ScrollViewer><StackPanel>
                        <TextBlock Text="Spiel bereits vorhanden" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="DuplicateGameText" Text="Dieses Spiel ist bereits in der Bibliothek." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,24"/>
                        <Button Content="Bestehendes Spiel öffnen" Click="DuplicateOpenExisting_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button x:Name="DuplicateAddVersionButton" Content="Als neue Version hinzufügen" Click="DuplicateAddVersion_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Content="Abbrechen" Click="DuplicateCancel_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="AbsoluteDeleteDialog" Visibility="Collapsed" Panel.ZIndex="110" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#C80A0B0D"/>
                <Border MaxWidth="560" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                        Background="#111317" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="24">
                    <ScrollViewer><StackPanel>
                        <TextBlock x:Name="AbsoluteDeleteTitle" Text="In Gelöscht verschieben" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="AbsoluteDeleteDescription" Text="Installation wird wiederherstellbar entfernt; das Save-Archiv wird gelöscht. Der Spieleintrag wandert in die Bibliothek Gelöscht." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,24"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Abbrechen" Click="CloseAbsoluteDeleteDialog_Click" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0"/>
                            <Button x:Name="ConfirmAbsoluteDeleteButton" Content="In Gelöscht verschieben" Click="ConfirmAbsoluteDelete_Click" Style="{StaticResource DangerButton}" Padding="18,0"/>
                        </StackPanel>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="SaveConflictDialog" Visibility="Collapsed" Panel.ZIndex="120" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
                <Border Background="#C80A0B0D"/>
                <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                        Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="24">
                    <ScrollViewer><StackPanel>
                        <TextBlock Text="Spielstände vorhanden" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Wie soll das Archiv wiederhergestellt werden? Der bisherige Zielordner bleibt als Sicherung neben dem Spielstandordner erhalten." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,24"/>
                        <Button Content="Ersetzen" Click="SaveConflictReplace_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Content="Zusammenführen" Click="SaveConflictMerge_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Content="Abbrechen" Click="SaveConflictCancel_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="ReinstallChoiceDialog" Visibility="Collapsed" Panel.ZIndex="130" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle"><Border Background="#BB0A0B0D"/><Border MaxWidth="640" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="24" Padding="24"><ScrollViewer><StackPanel><TextBlock Text="Wie möchtest du weitermachen?" Style="{DynamicResource PageTitle}"/><TextBlock x:Name="ReinstallChoiceTitle" Style="{DynamicResource SectionTitle}" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock x:Name="ReinstallSourceText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,20"/><Button x:Name="SourceInstallButton" Content="Über die Quelle installieren ↗" Click="SourceInstall_Click" Height="48" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,12"/><Button Content="Komprimierte Datei entpacken" Click="ExtractArchiveForReinstall_Click" Height="48" Margin="0,0,0,12"/><Button Content="Bereits installiert – Startdatei wählen" Click="LinkInstalled_Click" Height="48" Margin="0,0,0,12"/><Button Content="Abbrechen" Click="CloseReinstallChoice_Click"/></StackPanel></ScrollViewer></Border></Grid><Grid x:Name="SaveFinderDialog" Visibility="Collapsed" Panel.ZIndex="130" IsVisibleChanged="DialogVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle"><Border Background="#BB0A0B0D"/><Border MaxWidth="640" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111317" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="24" Padding="24"><ScrollViewer><StackPanel><TextBlock Text="Spielstände finden" Style="{DynamicResource PageTitle}"/><TextBlock x:Name="SaveFinderStatus" TextWrapping="Wrap" Style="{DynamicResource BodyText}" Margin="0,12,0,16"/><ItemsControl x:Name="SaveCandidates"><ItemsControl.ItemTemplate><DataTemplate><Button Click="ChooseSaveCandidate_Click" Height="Auto" MinHeight="70" Margin="0,0,0,10" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Path}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Style="{DynamicResource BodyText}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Schließen" Click="CloseSaveFinder_Click" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></Border></Grid><Grid x:Name="BusyOverlay" IsVisibleChanged="DialogVisibilityChanged" Visibility="Collapsed" Background="#ED0B1320" Panel.ZIndex="500">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
            <Button x:Name="BusyCancelButton" Content="Abbrechen" Click="CancelFileOperation_Click" Visibility="Collapsed" Margin="0,0,0,16"/>
            <TextBlock x:Name="BusyText" Text="Dateien werden verarbeitet ..." TextWrapping="Wrap" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
            <ProgressBar Height="3" IsIndeterminate="True" Foreground="{StaticResource AccentColor}" Background="{StaticResource SurfaceSecondary}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
 </Grid>
</Window>
