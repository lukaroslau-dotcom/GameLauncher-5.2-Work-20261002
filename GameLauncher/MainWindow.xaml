<Window x:Class="GameLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:converters="clr-namespace:GameLauncher.Converters"
 xmlns:controls="clr-namespace:GameLauncher.Controls" xmlns:views="clr-namespace:GameLauncher.Views"
 Title="GameLauncher" Width="1360" Height="900" MinWidth="1000" MinHeight="650"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"
 PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
 <Window.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PathToImageConverter x:Key="PathToImageConverter"/>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:ArtworkHeightConverter x:Key="ArtworkHeight"/><converters:CardWidthConverter x:Key="CardWidthConverter"/>
        <converters:StatusLabelConverter x:Key="StatusLabelConverter"/>
        <DataTemplate x:Key="GameCardTemplate"><controls:GameCard Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource CardWidthConverter}}" Margin="0,0,16,20"/></DataTemplate>
    </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="ShellGrid" ClipToBounds="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid x:Name="ContentShell" Margin="24,18,20,20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Style="{DynamicResource GlassPanel}" Padding="14,4" Margin="0,0,0,20"><DockPanel><TextBlock x:Name="StatusLineText" Text="Bereit" Foreground="{DynamicResource SuccessColor}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="SidebarStatsText" Style="{DynamicResource BodyText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button DockPanel.Dock="Right" Content="Downloads" Click="DownloadsNavigation_Click" Margin="8,0"/><Button DockPanel.Dock="Right" Content="Backups" Click="BackupsNavigation_Click" Margin="8,0"/><TextBlock DockPanel.Dock="Right" Text="Strg + K" Style="{DynamicResource Eyebrow}" VerticalAlignment="Center" Margin="16,0,0,0"/><TextBox x:Name="SearchGamesTextBox" Tag="Deine Spiele durchsuchen …" Background="Transparent" BorderThickness="0" TextChanged="SearchGamesTextBox_TextChanged" ToolTip="Bibliothek durchsuchen (Strg+K)"/></DockPanel></Border>
<Grid Grid.Row="1" x:Name="PageHost"><Grid x:Name="DownloadsPageHost" Visibility="Collapsed"><views:DownloadsView x:Name="DownloadPage"/></Grid><Grid x:Name="BackupsPageHost" Visibility="Collapsed"><views:BackupsView x:Name="BackupPage"/></Grid>
<Grid x:Name="HomeView"><views:DashboardView x:Name="HomeDashboard" PlayRequested="FeaturedPlay_Click" SettingsRequested="SettingsNavigationButton_Click" LibraryRequested="LibraryNavigationButton_Click" DiscoverRequested="ImportsButton_Click" QuietChanged="DashboardQuiet_Click"/></Grid>
            <Grid x:Name="LibraryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Bibliothek" Style="{DynamicResource PageTitle}" Margin="0,0,0,18"/>
<StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="LibrarySearchTextBox" Visibility="Collapsed" TextChanged="LibrarySearchTextBox_TextChanged"/>
<DockPanel>
    <Button x:Name="LibraryViewToggle" DockPanel.Dock="Right" Click="LibraryViewToggle_Click" Style="{DynamicResource SecondaryButton}" Padding="10" ToolTip="Ansicht wechseln" Width="40" Height="40"><TextBlock x:Name="LibraryViewToggleIcon" Text="&#xE8A9;" FontFamily="Segoe Fluent Icons" FontSize="16"/></Button>
    <Button x:Name="LibraryFilterToggleButton" DockPanel.Dock="Right" Content="Filter &amp; Sortierung ▾" Click="LibraryFilterToggle_Click" Style="{DynamicResource SecondaryButton}" Padding="14,0" Margin="0,0,8,0"/>
</DockPanel>
<Border x:Name="LibraryFilterPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,10,0,0">
    <StackPanel>
        <TextBlock Text="Anzeigen" Style="{DynamicResource Eyebrow}" Margin="0,0,0,10"/>
        <WrapPanel>
            <Button x:Name="FilterAllButton" Content="Alle" Tag="All" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterInstalledButton" Content="Installiert" Tag="Installed" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterUpdatesButton" Content="Updates" Tag="Updates" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterUnplayedButton" Content="Ungespielt" Tag="Unplayed" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button Content="Wunschliste" Tag="Wishlist" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/><Button x:Name="FilterFavoritesButton" Content="Favoriten" Tag="Favorites" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterWaitingButton" Content="Wartend" Tag="Waiting" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterFinishedButton" Content="Abgeschlossen" Tag="Finished" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="FilterProblemsButton" Content="Probleme" Tag="Problems" Click="LibraryFilter_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0" ToolTip="Prüft fehlende Spielordner und Startdateien"/>
        </WrapPanel>
        <TextBlock Text="Sortieren" Style="{DynamicResource Eyebrow}" Margin="0,8,0,10"/>
        <WrapPanel>
            <Button x:Name="SortNameButton" Content="Name" Tag="Name" Click="LibrarySort_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="SortRecentButton" Content="Zuletzt gespielt" Tag="Recent" Click="LibrarySort_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="SortPlaytimeButton" Content="Spielzeit" Tag="Playtime" Click="LibrarySort_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="SortUpdateButton" Content="Updates" Tag="Updates" Click="LibrarySort_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
            <Button x:Name="SortAddedButton" Content="Hinzugefügt" Tag="Added" Click="LibrarySort_Click" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}" Padding="14,0"/>
        </WrapPanel>
    </StackPanel>
</Border>
<Border x:Name="BulkActionBar" Visibility="Collapsed" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="11" Padding="12,6" Margin="0,10,0,0">
    <DockPanel>
        <Button Content="Auswahl aufheben" Click="BulkClearSelection_Click" Style="{DynamicResource SecondaryButton}" DockPanel.Dock="Right" Padding="14,0" Margin="8,0,0,0"/>
        <Button Content="Als Favorit markieren" Click="BulkSetFavorite_Click" Style="{DynamicResource SecondaryButton}" DockPanel.Dock="Right" Padding="14,0" Margin="0,0,8,0"/>
        <TextBlock x:Name="BulkActionText" VerticalAlignment="Center" Style="{DynamicResource BodyText}"/>
    </DockPanel>
</Border>
</StackPanel>
<Grid Grid.Row="2">
                    <ListBox x:Name="LibraryItemsControl" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                    <ListBox x:Name="LibraryListControl" Style="{StaticResource GameList}" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,6" Padding="14" Cursor="Hand" MouseLeftButtonDown="GameCard_Click" KeyDown="Card_KeyDown"><DockPanel><Border Width="60" Height="60" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource SurfaceSecondary}" Margin="0,0,14,0"><controls:CroppedImage ImagePath="{Binding CoverPath}" FocusX="{Binding CoverFocusX}" FocusY="{Binding CoverFocusY}" DecodeWidth="120" FitInside="True"/></Border><StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="120"><TextBlock Text="{Binding GameVersion}" Style="{DynamicResource Eyebrow}" Foreground="{DynamicResource TextTertiary}"/><TextBlock Text="{Binding PathWarning}" Style="{DynamicResource BodyText}" Foreground="{DynamicResource DangerColor}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="160"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Style="{DynamicResource BodyText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"><Run Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"/><Run Text=" · "/><Run Text="{Binding InstallSource, Mode=OneWay}"/></TextBlock></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <StackPanel x:Name="LibraryEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Keine passenden Spiele." Style="{DynamicResource SectionTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Füge ein Spiel hinzu oder ändere die Filter." Style="{DynamicResource BodyText}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
                        <Button Content="Spiel hinzufügen" Click="OpenAddGameButton_Click" Style="{DynamicResource PrimaryButton}" Width="140" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="AvailableUpdatesView" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12"><Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Content="Jetzt prüfen" Click="CheckUpdatesButton_Click" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/><StackPanel><TextBlock Text="Updates" Style="{DynamicResource PageTitle}"/><TextBlock Text="Kontofreie Prüfung deiner gespeicherten F95-Quellen" Style="{DynamicResource BodyText}" Margin="0,5,0,0"/></StackPanel></DockPanel>
                <TextBlock x:Name="UpdateCheckStatusText" Grid.Row="1" Text="Noch nicht geprüft." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border x:Name="UpdateErrorsPanel" Visibility="Collapsed" Background="#302C2630" BorderBrush="{DynamicResource WarningColor}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock Text="Nicht geprüfte Spiele" Foreground="{DynamicResource WarningColor}" FontWeight="SemiBold" Margin="0,0,0,8"/><ScrollViewer MaxHeight="150"><ItemsControl x:Name="UpdateErrorsItemsControl"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><Button DockPanel.Dock="Right" Content="Website öffnen" Click="OpenUpdateErrorSource_Click" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdateCheckError}" Style="{DynamicResource BodyText}" TextWrapping="Wrap"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border><Grid Grid.Row="1"><ListBox x:Name="AvailableUpdatesItemsControl" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><StackPanel x:Name="AvailableUpdatesEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Alles aktuell" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/><TextBlock Text="Keine Updates verfügbar. F95-Links werden automatisch erkannt." Style="{DynamicResource BodyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,8,0,0"/></StackPanel></Grid></Grid>
                <TextBlock x:Name="RecentlyUpdatedLabel" Grid.Row="3" Text="Kürzlich aktualisiert" Style="{DynamicResource SectionTitle}" Margin="0,24,0,12" Visibility="Collapsed"/>
                <ListBox x:Name="RecentlyUpdatedItemsControl" Grid.Row="4" Style="{StaticResource GameList}" ItemTemplate="{StaticResource GameCardTemplate}" Visibility="Collapsed"><ListBox.ItemsPanel><ItemsPanelTemplate><controls:VirtualizingGamePanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
            </Grid>

            <Grid x:Name="AddGameView" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Grid.Row="0" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Zurück" Click="BackToHomeButton_Click" Margin="16,0,0,0"/><StackPanel><TextBlock x:Name="GameFormTitleTextBlock" Text="Spiel hinzufügen" Style="{DynamicResource PageTitle}"/><TextBlock Text="Ein neuer Platz in deiner Sammlung." Style="{DynamicResource BodyText}" Margin="0,6,0,0"/></StackPanel></DockPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><controls:AdaptiveColumns Breakpoint="800" FirstRatio="0.38" SecondFirstWhenStacked="True" Margin="0,0,0,96">
<StackPanel><Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Dein Cover" Style="{DynamicResource SectionTitle}" Margin="0,0,0,16"/>
<Border x:Name="GameCoverBorder" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ArtworkHeight}}" CornerRadius="16" Background="{DynamicResource SurfaceSecondary}" ClipToBounds="True"><Grid><TextBlock Text="✧" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/><controls:CroppedImage x:Name="GameCoverImage" CanDrag="True" DecodeWidth="1000" ToolTip="Ziehen, um den Bildausschnitt zu verschieben"/></Grid></Border>
<TextBlock Text="Bild ziehen, um den Ausschnitt zu verschieben." TextWrapping="Wrap" Style="{DynamicResource BodyText}" Margin="0,12,0,0"/><Button Content="Cover wählen" Click="SelectCoverButton_Click" Margin="0,18,0,0"/></StackPanel></Border>
<Border Style="{DynamicResource GlassPanel}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Notizen" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Optional · Installationshinweise, Mods oder Erinnerungen" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,14"/><TextBox x:Name="GameNotesTextBox" Height="120" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap" MaxLength="4000" VerticalScrollBarVisibility="Auto"/></StackPanel></Border></StackPanel>
<Border Style="{DynamicResource GlassPanel}"><StackPanel><TextBlock Text="Spieldaten" Style="{DynamicResource SectionTitle}"/>
<TextBlock Text="Name *" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><TextBox x:Name="GameNameTextBox" Tag="Wie heißt dein Spiel?" /><TextBlock x:Name="GameNameTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<TextBlock Text="Version *" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><TextBox x:Name="GameVersionTextBox" Tag="z. B. 1.0" /><TextBlock x:Name="GameVersionTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<TextBlock Text="Quelle *" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><TextBox x:Name="InstallSourceTextBox" Tag="z. B. F95Zone-Link oder Lokal" LostKeyboardFocus="InstallSourceTextBox_LostKeyboardFocus"/><TextBlock x:Name="InstallSourceTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/><WrapPanel Margin="0,8,0,0"><Button x:Name="LoadF95MetadataButton" Content="F95-Daten laden" Click="LoadF95MetadataButton_Click" Margin="0,0,8,8"/><Button x:Name="SmartArchiveButton" Content="ZIP auswählen &amp; automatisch einrichten" Click="SmartArchiveButton_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="F95MetadataStatusText" Text="1. F95-Link einfügen · 2. Daten laden · 3. ZIP wählen. Ordner, Startdatei und Saves werden automatisch gesucht." Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
<TextBlock Text="Spielordner *" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GamePathTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="Wählen" Click="SelectGameFolderButton_Click" Margin="10,0,0,0"/></Grid><TextBlock x:Name="GamePathTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<TextBlock Text="Startdatei *" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExecutableTextBox" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="Wählen" Click="SelectExecutableButton_Click" Margin="10,0,0,0"/></Grid><TextBlock x:Name="ExecutableTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<TextBlock Text="Spielstandordner (optional)" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SavePathTextBox" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="Wählen" Click="SelectSaveFolderButton_Click" Margin="10,0,0,0"/></Grid><TextBlock x:Name="SavePathTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<WrapPanel Margin="0,12,0,0"><Button Content="Saves finden" Click="FindSaves_Click" Margin="0,0,8,8"/><Button x:Name="ProbeSaveButton" Content="Spiel starten und Save-Ordner suchen" Click="LaunchToCreateSave_Click" Margin="0,0,8,8"/><Button Content="Später festlegen" Click="UnknownSave_Click" Margin="0,0,8,8"/></WrapPanel><CheckBox x:Name="ManageLocalGameCheckBox" Content="Spiel in den GameLauncher-Ordner verschieben" IsChecked="True" ToolTip="Der gesamte ausgewählte Spielordner wird sicher in die GameLibrary übernommen." Margin="0,14,0,0"/><CheckBox x:Name="GameFavoriteCheckBox" Content="Als Favorit merken" Margin="0,12,0,0"/>
<TextBlock Text="Mod-Link (optional)" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><TextBox x:Name="GameModUrlTextBox" Tag="Link zur Mod-Seite oder zum Mod-Beitrag"/>
<TextBlock Text="Zusätzliche Versionsinformationen (optional)" Style="{DynamicResource BodyText}" Margin="0,12,0,6"/><TextBox x:Name="GameVersionInfoTextBox" Tag="Build, Änderungen oder eigene Hinweise" MaxLength="2000"/><TextBlock x:Name="GameVersionInfoTextBoxError" Foreground="{DynamicResource DangerColor}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
<TextBlock Text="* Pflichtangaben für installierte Spiele" Style="{DynamicResource Eyebrow}" Margin="0,16,0,0" TextWrapping="Wrap"/>
</StackPanel></Border></controls:AdaptiveColumns></ScrollViewer>
<WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="WishlistButton" Content="Zur Wunschliste hinzufügen" Click="WishlistButton_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,12,0"/><Button x:Name="SaveGameButton" Content="Spiel hinzufügen" Click="AddGameButton_Click" Style="{DynamicResource PrimaryButton}"/></WrapPanel>
</Grid>
<Grid x:Name="GameDetailView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Spieldetails" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="" Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Content="Zurück" Click="BackFromGameDetailButton_Click" Style="{StaticResource SecondaryButton}" Width="105" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,96">
                    <Border x:Name="GameDetailHero" Height="320" CornerRadius="24" ClipToBounds="True" Background="{DynamicResource SurfaceSecondary}" Margin="0,0,0,18"><Grid>
                        <controls:CroppedImage x:Name="GameDetailHeroBackdrop" DecodeWidth="1000" AnimateGif="False" Opacity="0.5"/><Border Background="#A00A0B0D"/>
                        <controls:CroppedImage x:Name="GameDetailCoverImage" DecodeWidth="900" FitInside="True" CanDrag="True" CropChanged="GameDetailCoverImage_CropChanged" ToolTip="Das vollständige Cover wird angezeigt; Ziehen speichert weiterhin den Fokus für zugeschnittene Hintergründe" Margin="28"/>
                    </Grid></Border>
                    <StackPanel x:Name="GameDetailGallerySection" Visibility="Collapsed" Margin="0,0,0,22"><DockPanel Margin="2,0,2,12"><TextBlock Text="Spielbilder" Style="{DynamicResource SectionTitle}"/><TextBlock x:Name="GameDetailGalleryCount" DockPanel.Dock="Right" Style="{DynamicResource BodyText}"/></DockPanel><ItemsControl x:Name="GameDetailGalleryItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="280" Height="158" Margin="0,0,12,12" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource SurfaceSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"><controls:CroppedImage ImagePath="{Binding}" DecodeWidth="560" FitInside="True"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    <controls:AdaptiveColumns Breakpoint="0" FirstRatio="0">
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Border Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ArtworkHeight}}" CornerRadius="16" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
                                <controls:CroppedImage DecodeWidth="1000" FitInside="True"/>
                            </Border>
                            <TextBlock Text="Bild mit gedrückter Maustaste verschieben · Position wird automatisch gespeichert" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="GameDetailNameTextBlock" Text="Name" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="16" Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,18">
                                <TextBlock x:Name="GameDetailStatusTextBlock" Text="Installiert" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                            </Border>
                            <Border x:Name="GameDetailUpdatePanel" Background="#303F67" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel><TextBlock Text="Update verfügbar" Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold"/><TextBlock x:Name="GameDetailUpdateText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,5,0,10"/><WrapPanel><Button Content="Update installieren …" Click="GameDetailInstallButton_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Neue Version ist schon installiert" Click="MarkOnlineVersionInstalled_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="Diese Version ignorieren" Click="IgnoreOnlineVersion_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
                            <Border x:Name="GameDetailUpdateErrorPanel" Background="#302C2630" BorderBrush="{DynamicResource WarningColor}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel><TextBlock Text="Update-Prüfung nicht möglich" Foreground="{DynamicResource WarningColor}" FontWeight="SemiBold"/><TextBlock x:Name="GameDetailUpdateErrorText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border x:Name="GameDetailPathWarningPanel" Background="#302C2630" BorderBrush="{DynamicResource DangerColor}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel><TextBlock Text="Installation nicht erreichbar" Foreground="{DynamicResource DangerColor}" FontWeight="SemiBold"/><TextBlock x:Name="GameDetailPathWarningText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,5,0,10"/><Button Content="Installation neu verknüpfen" Click="RelinkMissingGame_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                            <WrapPanel>
                                <Button x:Name="GameDetailPlayButton" Content="Spielen" Click="GameDetailPlayButton_Click" Style="{StaticResource PrimaryButton}" Padding="25,0" Margin="0,0,10,8"/>
                                <Button Content="Erweiterte Angaben …" Click="EditAdvancedMetadata_Click" Margin="0,0,10,8"/><Button Content="Vorherige Version …" Click="RollbackInstallation_Click" Margin="0,0,10,8"/><Button x:Name="GameDetailInstallButton" Content="Installieren" Click="GameDetailInstallButton_Click" Style="{StaticResource PrimaryButton}" Padding="25,0" Margin="0,0,10,8" Visibility="Collapsed"/>
                                <Button x:Name="GameDetailEditButton" Content="Bearbeiten" Click="GameDetailEditButton_Click" Style="{StaticResource SecondaryButton}" Padding="25,0" Margin="0,0,10,8"/>
                                <Button x:Name="GameDetailFavoriteButton" Content="Favorit" Click="GameDetailFavoriteButton_Click" Style="{StaticResource SecondaryButton}" Padding="20,0" Margin="0,0,10,8"/>
                                <Button x:Name="GameDetailDeleteButton" Content="Entfernen" Click="GameDetailDeleteButton_Click" Style="{StaticResource DangerButton}" Padding="20,0" Margin="0,0,10,8"/>
