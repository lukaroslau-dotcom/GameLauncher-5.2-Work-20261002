                                <ItemsControl x:Name="GameDetailVersionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="12" Padding="14" Margin="0,0,0,8">
