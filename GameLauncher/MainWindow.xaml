                                </Border>
                                <Border Style="{DynamicResource GlassPanel}" Margin="0,0,0,16" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Installationsdetails" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Version" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailVersionTextBlock" Text="-" Style="{DynamicResource BodyText}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Quelle" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailSourceTextBlock" Text="-" Style="{DynamicResource BodyText}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock x:Name="GameDetailF95MetaTextBlock" Text="" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="120,0,0,8" Visibility="Collapsed"/>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Spielordner" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailGamePathTextBlock" Text="-" Style="{DynamicResource BodyText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Spielstand" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailSavePathTextBlock" Text="-" Style="{DynamicResource BodyText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="Startdatei" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailExecutableTextBlock" Text="-" Style="{DynamicResource BodyText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,0">
                                                <TextBlock Text="Spielzeit" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailPlaytimeTextBlock" Text="0h 0min played" Style="{DynamicResource BodyText}"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="Zuletzt gespielt" Style="{DynamicResource Eyebrow}" Width="120" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="GameDetailLastPlayedTextBlock" Text="Noch nie" Style="{DynamicResource BodyText}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            <StackPanel x:Name="GameDetailVersionsSection" Visibility="Collapsed">
                                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,8,0,16"/>
