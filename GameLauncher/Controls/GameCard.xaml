<UserControl x:Class="GameLauncher.Controls.GameCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:GameLauncher.Converters" xmlns:controls="clr-namespace:GameLauncher.Controls" Focusable="False">
<UserControl.ContextMenu>
<ContextMenu x:Name="GameContextMenu" Opened="ContextMenu_Opened">
<MenuItem x:Name="CtxPlay" Header="Spielen" Click="CtxPlay_Click"/>
<MenuItem x:Name="CtxInstall" Header="Installieren" Click="CtxInstall_Click" Visibility="Collapsed"/>
<Separator/>
<MenuItem x:Name="CtxOpenFolder" Header="Ordner öffnen" Click="CtxOpenFolder_Click"/>
<MenuItem x:Name="CtxOpenF95" Header="F95-Seite öffnen" Click="CtxOpenF95_Click"/>
<Separator/>
<MenuItem x:Name="CtxEdit" Header="Bearbeiten" Click="CtxEdit_Click"/>
<MenuItem x:Name="CtxFavorite" Header="Favorit umschalten" Click="CtxFavorite_Click"/>
<MenuItem x:Name="CtxStatus" Header="Status ändern">
<MenuItem x:Name="CtxStatusInstalled" Header="Installiert" Click="CtxStatus_Click" Tag="Installed"/>
<MenuItem x:Name="CtxStatusWaiting" Header="Wartend" Click="CtxStatus_Click" Tag="Waiting for Updates"/>
<MenuItem x:Name="CtxStatusFinished" Header="Abgeschlossen" Click="CtxStatus_Click" Tag="Finished"/>
</MenuItem>
<Separator/>
<MenuItem x:Name="CtxDelete" Header="Löschen" Click="CtxDelete_Click" Foreground="{DynamicResource DangerColor}"/>
</ContextMenu>
</UserControl.ContextMenu>
<UserControl.Resources><conv:ArtworkHeightConverter x:Key="ArtworkHeight"/><conv:PathToImageConverter x:Key="Cover"/><conv:StatusLabelConverter x:Key="Status"/><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
<Border x:Name="Frame" CornerRadius="16" Background="Transparent" Focusable="True" Margin="0,0,0,8" Padding="0" AutomationProperties.Name="{Binding Name}" MouseLeftButtonUp="Open_Click" KeyDown="Open_KeyDown" MouseEnter="Frame_Enter" MouseLeave="Frame_Leave" GotKeyboardFocus="Frame_Enter" LostKeyboardFocus="Frame_Leave">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SurfaceSecondary}"><Grid Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource ArtworkHeight}}">
<controls:CroppedImage x:Name="CardImage" ImagePath="{Binding CoverPath}" FocusX="{Binding CoverFocusX}" FocusY="{Binding CoverFocusY}" FitInside="True" DecodeWidth="640"/>
<Border x:Name="ArtOverlay" Background="#800A0B0D" Opacity="0" IsHitTestVisible="False"/>
<Button x:Name="HoverPlayButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Width="44" Height="44" Opacity="0" Style="{DynamicResource PrimaryButton}" Click="Launch_Click" Padding="0"/>
<Border Background="#C80A0B0D" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,4"><TextBlock Text="{Binding Status, Converter={StaticResource Status}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></Border>
<Border x:Name="UpdateBadge" Background="{DynamicResource AccentColor}" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,4" Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}"><TextBlock Text="Update" FontSize="11" FontWeight="SemiBold" Foreground="#101116"/></Border>
<Border x:Name="PathWarningBadge" Background="#C8A23B4B" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,4" Visibility="{Binding HasPathWarning, Converter={StaticResource Visible}}" ToolTip="{Binding PathWarning}"><TextBlock Text="Pfad fehlt" FontSize="11" FontWeight="SemiBold" Foreground="White"/></Border>
</Grid></Border>
<Grid Grid.Row="1" Margin="2,10,2,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center">
<TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
</StackPanel>
<Button x:Name="FavoriteButton" Grid.Column="1" Content="☆" Width="28" Height="28" Padding="0" FontSize="12" Style="{DynamicResource SecondaryButton}" Click="Favorite_Click" ToolTip="Favorit umschalten"/>
</Grid>
<Grid Grid.Row="2" Margin="2,4,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GameVersion}" Foreground="{DynamicResource TextTertiary}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameVersion}"/><TextBlock x:Name="InstalledSizeText" Grid.Column="1" Foreground="{DynamicResource TextTertiary}" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="Größe der Dateien im Spielordner einschließlich Unterordnern (1024 Bytes pro KB). Bei fehlenden, nicht lesbaren oder verknüpften Ordnern ist die Größe unbekannt."/></Grid>
</Grid></Border>
</UserControl>
